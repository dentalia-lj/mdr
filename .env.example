# PRD v3 §11 config surface — real values in .env (gitignored)
DATABASE_URL=postgresql://dentalia:dentalia@localhost:5432/dentalia
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# S2.4 email.poll mailbox login (secrets — same footing as the keys above, not
# tuning knobs). Empty until the client provisions the compliance inbox (GAP G8);
# the poll is flag-gated off (SCHEDULER_EMAIL_POLL_ENABLED) until they exist.
IMAP_USER=
IMAP_PASSWORD=
# Access credentials for the two non-browser caller classes reaching `web`
# (docs/superpowers/specs/2026-08-25-item-document-access-design.md §8) —
# secrets, same footing as the keys above, not tuning knobs.
# WEB_API_KEYS is comma-separated so a second consumer or a rotation is an env
# change rather than a downtime swap; it authenticates the webshop backend via
# X-API-Key. WEB_BC_LINK_KEY is the single shared value BC concatenates into
# /item/{ref}?k=… — shared and static because a BC hyperlink is a computed
# field and cannot compute a signature.
# EMPTY DISABLES THE CLASS IT NAMES; empty never means "allow everyone" —
# no WEB_BC_LINK_KEY means /item/* 404s outright.
WEB_API_KEYS=
WEB_BC_LINK_KEY=
# Absolute base prefixed onto the document URLs the item payload emits. Empty
# leaves them relative, which is right for same-origin browser use and wrong
# for a webshop backend embedding our links in its own pages.
WEB_PUBLIC_BASE_URL=
# Business Central (worker; BC_WRITE_ENABLED also on web). Reached over plain
# HTTP from the server's allowlisted address only (docs/decisions.md,
# 2026-09-24). Login is NTLM inside Negotiate: a Windows domain account,
# DOMAIN\user, SINGLE-QUOTED so the backslash survives. Empty BC_BASE_URL
# means no client. BC_WRITE_ENABLED=true lets bc.push and its hourly drift cron
# write the three dataitems fields -- set WEB_PUBLIC_BASE_URL and
# WEB_BC_LINK_KEY above first, they are what pteWarehouseURL is built from.
# A refused password is not retried until the worker restarts (domain lockout).
BC_BASE_URL=
BC_USERNAME=
BC_PASSWORD=
BC_WRITE_ENABLED=false
BC_DRIFT_CAP=1000
# The hourly bc.push-drift cron needs this AND BC_WRITE_ENABLED. Keep it off
# until the first bulk apply (/bc-push) has been checked: with an empty ledger
# every item counts as changed. On both worker and web.
SCHEDULER_BC_PUSH_DRIFT_ENABLED=false
# Operator alerts. Declared on BOTH `worker` and `web` in docker-compose.yml and
# the ONLY mechanism that announces a dead-lettered job to a human — yet it was
# missing from this file until 2026-09-14, so nobody setting up a server was
# prompted to set it. Empty disables it. Use a LONG RANDOM ntfy topic: the URL
# is the whole credential, and a topic is readable AND writable by anyone who
# knows its name.
ALERTS_WEBHOOK_URL=
GATE_THRESHOLD_HIGH=0.92
GATE_THRESHOLD_MED=0.75
SOURCE_ADAPTER=csv
STORAGE_ADAPTER=local
SEARCH_ADAPTER=brave
MODELS_T1=claude-haiku-4-5
MODELS_T2=claude-sonnet-5
MODELS_RANK=claude-haiku-4-5
# Inbound email-body summarisation (S2.4). Its own key, not `rank`:
# a tier swap must not move a model that was never diffed for it.
MODELS_EMAIL_SUMMARY=claude-haiku-4-5
BATCH_POLL_INTERVAL_S=900
FETCH_POLITENESS_MS=2000
FETCH_RECENCY_WINDOW_DAYS=21
BUDGET_SWEEP_CAP_EUR=100
BUDGET_MONTHLY_CAP_EUR=40
# Approximate USD->EUR conversion for the KPI board's spend tile (S1.6, K8) —
# not a live FX rate; update by hand periodically.
BUDGET_EUR_PER_USD=0.92

# FETCH archive (S1.4). STORAGE_ADAPTER above selects the store: `local`
# (LocalFsStore — the DEFAULT since 2026-07-31, [storage-default]) writes under
# STORAGE_LOCAL_ROOT. `local` is the default; `gdrive` (GoogleDriveStore) is not
# a working option -- its put() raises until G7 is answered
# (Drive auth) is answered — opt in only once G7 lands. STORAGE_BASE_URL
# empty -> LocalFsStore returns a file:// URI. STORAGE_GDRIVE_FOLDER_ID is the
# Drive root (unused until G7).
# Absolute path inside the container, backed by the `archive_data` volume.
# A relative value works on the host but is LOST on container restart.
STORAGE_LOCAL_ROOT=/archive
# Serve archived files through the web UI. Empty gives file:// URIs that
# nothing downstream can open.
STORAGE_BASE_URL=/archive
STORAGE_GDRIVE_FOLDER_ID=

# INGEST (S1.1). Unclassified items (blank BC device class, 61% of the LJ export)
# are tri-state md_flag=None. true (default) processes + counts them; false holds
# them out (still counted). Per-supplier mfr_ref remap is TOML-only (no env var):
# [ingest.mfr_ref_source_by_code] "<mfr_code>" = "item_ref".
INGEST_PROCESS_MD_UNKNOWN=true

# RESOLVE (S1.2) name-family thresholds (G5a defaults — tune from hand-labeled
# pairs in the pre-S1.7 calibration session before the sweep).
#
# SUGGEST IS EQUAL TO ACCEPT ON PURPOSE (Denis, 2026-08-12). A gap
# between them re-opens the staging band, and a banded item gets NO
# `item_group_member` row while every REF-gate path joins through that table —
# measured, it left 5.831 of 15.958 items (36,5%) unreachable by any document.
# This file said 0.72 until 2026-09-14, which is the value the code default
# replaced; a `.env` copied from here would have reverted the ruling on the
# first deploy that wired these keys up. Do not restore 0.72 without redoing
# the measurement.
RESOLVE_NAME_ACCEPT=0.90
RESOLVE_NAME_SUGGEST=0.90
RESOLVE_NAME_CANDIDATE_K=20

# DISCOVER (S1.3) ladder tunables. DISCOVER_EMAIL_RUNG_ENABLED gates the email
# rung's PRODUCER side (same pattern as the SCHEDULER *_ENABLED flags): off
# until the S2.4 EMAIL handler exists, so email.request jobs aren't swallowed
# by the no-op — the rung logs `skipped` and falls through to manual.
DISCOVER_TOPK=3
DISCOVER_RANK_THRESHOLD=0.60
DISCOVER_RECENCY_DAYS=30
DISCOVER_MAX_SEARCH_CANDIDATES=10
DISCOVER_EMAIL_RUNG_ENABLED=false
# Corpus-first cold start: RESOLVE builds groups but emits no discover.group, so
# a first ingest does not web-search for documents already in imports/. Held
# emissions are counted on the job result as `discover_held`. Unwind with
# `cli regroup --manufacturer NAME --apply` after clearing this. Steady state: false.
#
# compose sets this to TRUE for the worker (docker-compose.yml:199), because the
# code default is false and nothing in the stack said so: with an empty registry
# and a live BRAVE_API_KEY, re-resolving the catalogue fires one search per
# group for documents already sitting in imports/.
#
# LEAVE IT COMMENTED. It was shipped uncommented as `false` until 2026-09-22,
# with a note above it calling it "the host-side default only" -- which is
# wrong. `${DISCOVER_HOLD:-true}` falls back only when the variable is UNSET or
# EMPTY, and `false` is neither, so a .env copied from this file as
# docs/dev/deployment.md § 3 instructs turned the corpus-first hold OFF on the
# very first bring-up: one discovery ladder per group against 8.208 groups, for
# documents the corpus already holds.
#
# Uncomment only at deployment.md § 6.7, when the corpus is in and someone is
# reviewing. Confirm the state first:
#     docker compose config | grep DISCOVER_HOLD      # expect true
# Unwind per manufacturer afterwards with `cli regroup --manufacturer NAME --apply`.
# DISCOVER_HOLD=false

# Standalone web (producer UI) — not in PRD §11, same footing as queue tuning.
# api_database_url connects as dentalia_api (Invariant 1), never the owner.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_IMPORTS_DIR=/imports
UPLOAD_MAX_MB=25
API_DATABASE_URL=postgresql://dentalia_api:dentalia_api@localhost:5432/dentalia
# G3 v0 auth (S1.6): true only when a trusted reverse proxy (docker-compose.yml
# `caddy` service) sits in front and sets WEB_TRUSTED_USER_HEADER. Local/host
# dev leaves this false. With neither a proxy nor a form value, review
# decisions are recorded as `user:admin` (web/app.py DEFAULT_DECIDED_BY) until
# real logins land.
WEB_REQUIRE_AUTHENTICATED_USER=false
WEB_TRUSTED_USER_HEADER=X-Forwarded-User

# Where the archived PDFs are, as seen BY THE WEB PROCESS. `document
# .archive_url` stores the path whatever wrote it saw — for backfilled corpus
# documents that is a host path, which does not exist inside the container.
# Set IMPORTS_HOST_ABS to the absolute host path of the imports mount and
# compose turns it into WEB_PATH_REWRITES ("<from>=<to>", comma-separated) so
# the document links resolve directly. Optional: without it the file route
# still finds the file by verifying candidates against the stored sha256,
# which costs a hash per request. Relocating the archive is this variable
# plus WEB_ARCHIVE_ROOT — never a code change.
IMPORTS_HOST_ABS=
# WEB_PATH_REWRITES=/home/you/dentalia/imports=/imports

# Which logins may run the four operator-only actions (office UI redesign
# spec § 2, D3): the playbook edit and code claim, the Business Central push
# apply, the scheduler Run now / Arm buttons, and /ingest. Comma-separated,
# matched exactly against the Caddy login in WEB_TRUSTED_USER_HEADER.
# EMPTY (the default) means EVERY login is an operator and nothing is refused,
# which is what keeps a shared login working. Naming anyone here also hides the
# Operator menu group from everyone else; their pages stay reachable by URL.
WEB_OPERATOR_USERS=

# Caddy reverse proxy (G3 v0) — HTTP Basic in front of `web`, the sole
# ingress on API_PORT in compose. Generate the hash with:
#   docker compose run --rm caddy caddy hash-password --plaintext 'your-password'
#
# This pair is the fallback account. One login per person goes in a file under
# caddy/users/ instead (see caddy/users/README.md), gitignored, since the
# hashes are the credential, and mounted read-only into the caddy container.
DENTALIA_WEB_USER=admin
DENTALIA_WEB_PASSWORD_HASH=

# SCHEDULER (S1.5) — cron cadence, not PRD §11. SCHEDULER_INGEST_WATCH_DIR
# empty (default) disables the monthly ingest tick (no live BC feed exists —
# G4 residue); set it to enable, and SCHEDULER_INGEST_CATALOGUE selects which
# catalogue the glob's latest match ingests as. The two *_ENABLED flags gate
# emission of email.request / playbook.reonboard (default off — S2.4/S2.1
# consumers don't exist yet); the underlying scans run regardless.
SCHEDULER_TICK_INTERVAL_S=300
SCHEDULER_INGEST_WATCH_DIR=
SCHEDULER_INGEST_GLOB=*.xlsx
SCHEDULER_INGEST_CATALOGUE=LJ
SCHEDULER_EXPIRY_SCAN_INTERVAL_HOURS=24
SCHEDULER_EXPIRY_EMAIL_ENABLED=false
SCHEDULER_FAILURE_MONITOR_INTERVAL_HOURS=24
SCHEDULER_FAILURE_WINDOW_DAYS=30
SCHEDULER_FAILURE_MISS_RATE_THRESHOLD=0.5
SCHEDULER_FAILURE_MIN_SAMPLE=5
SCHEDULER_FAILURE_REONBOARD_ENABLED=false
# S2.4 EMAIL inbound (email.poll). SCHEDULER_EMAIL_POLL_ENABLED gates emission
# of email.poll (default off — no mailbox creds exist, GAP G8; same producer
# gating as the flags above). The poll fires once per INTERVAL_HOURS window.
SCHEDULER_EMAIL_POLL_ENABLED=false
SCHEDULER_EMAIL_POLL_INTERVAL_HOURS=6

# EMAIL inbound mailbox (S2.4). EMAIL_ADAPTER selects imap (real) | fake (tests).
# IMAP_HOST empty (default) leaves the poll unconfigured — ImapEmailAdapter
# raises cleanly and the rung is skipped, never dead-lettered. Credentials
# (IMAP_USER/IMAP_PASSWORD) are secrets, set at the top of this file.
EMAIL_ADAPTER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_FOLDER=INBOX
# First day of mail to read, YYYY-MM-DD -- the day of the first production
# deploy. Mail that arrived before it is never fetched. REQUIRED once IMAP_HOST
# and the credentials are set: without it the poll dead-letters, loudly, rather
# than read the mailbox's whole history. The poll is read-only either way: it
# opens the folder with EXAMINE, never marks, moves or deletes anything, and
# keeps its own record of what it took in email_poll_log.
EMAIL_POLL_SINCE=
# Messages taken per poll. Pacing, not a limit: new mail past it waits for the
# next poll and is counted on the job result as deferred_to_next_poll.
EMAIL_POLL_MAX_MESSAGES=200
# Archives (2026-08-20). Suppliers send zips of documents, and the magic-byte
# gate correctly refuses the archive itself -- so without expansion the PDFs
# inside are simply lost. Every bound exists because the sender controls the
# bytes: a 42 KB zip can expand to 4.5 GB, and the ratio guard is decided on the
# DECLARED sizes before anything is decompressed. Nested archives are refused,
# never followed. Set EMAIL_ZIP_EXPAND=false to go back to refusing archives
# outright (they are then recorded as `archive-not-expanded`, not dropped).
EMAIL_ZIP_EXPAND=true
EMAIL_ZIP_MAX_MEMBERS=50
EMAIL_ZIP_MAX_MEMBER_MB=25
EMAIL_ZIP_MAX_TOTAL_MB=100
EMAIL_ZIP_MAX_RATIO=200
# Body summarisation (2026-08-20, invariant 12 widened + ratified). The body is
# read at poll time, summarised by the cheap tier, and DROPPED -- only the
# summary is stored, so `/emails` can say what a message asked for without this
# registry keeping supplier correspondence verbatim for ten years. UI context
# only: never evidence, never a production value, never a GATE/VALIDATE input.
# One call per message, ever -- a message is summarised on the poll that records
# it and is never polled again, and a failed summary still records its row so it
# does not retry. Set EMAIL_SUMMARY_ENABLED=false to record `disabled` instead.
EMAIL_SUMMARY_ENABLED=true
# 0 = no floor: if there is a body it gets a summary, however short (Denis,
# 2026-08-21). The body is never stored, so skipping the call on a one-liner
# left the row with no text at all -- emptier than the long messages beside it.
# Raise this only to throttle a genuinely noisy mailbox; it records `too-short`.
EMAIL_SUMMARY_MIN_CHARS=0
EMAIL_SUMMARY_MAX_CHARS=6000
EMAIL_SUMMARY_MAX_TOKENS=200
# EMAIL outbound (S2.4). The client's cadence rule (spec §7.2): at most one
# renewal mail per manufacturer per CADENCE_DAYS, listing everything expiring
# for them. Changing the cadence changes the dedupe bucket
# (`email.request:mfr:{manufacturer}:{period_key}`); in-flight requests keep
# their old key and drain. REMINDER_AFTER_DAYS is a different clock: how long
# silence lasts before a follow-up is drafted. ESCALATE_AFTER stops the drafting
# so an unanswered chase does not fill the board forever.
RENEWAL_REQUEST_CADENCE_DAYS=7
RENEWAL_REMINDER_AFTER_DAYS=14
RENEWAL_ESCALATE_AFTER_REMINDERS=3
# Fake mailbox (docker-compose `greenmail`, profile `email-dev`) — exercises the
# real IMAP path with no client dependency (GAP G8). Uncomment to point the
# worker at it. The values are real-like on purpose: moving to the client's
# inbox changes host/user/password and NOTHING else.
#   docker compose --profile email-dev up -d greenmail
#   python tools/seed_fake_mailbox.py
# GreenMail storage is IN-MEMORY — restarting it empties the mailbox; re-run the
# seed script, which is the source of truth for what the mailbox contains.
# EMAIL_ADAPTER=imap
# IMAP_HOST=greenmail                 # from the host instead: 127.0.0.1
# IMAP_PORT=3143                      # plain IMAP — GreenMail's IMAPS cert is self-signed
# IMAP_SSL=false
# IMAP_USER=dokumentacija@dentalia.si # full address, because users.login=email
# IMAP_PASSWORD=dentalia
# EMAIL_POLL_SINCE=2026-01-01            # SINCE is the day GreenMail received it, not the Date: header
# GREENMAIL_USER_SPEC is the SERVER-side account and is NOT "user:password" —
# GreenMail's format is local-part:password@domain, so the password sits in the
# middle. Keep it in step with IMAP_USER/IMAP_PASSWORD above.
# GREENMAIL_USER_SPEC=dokumentacija:dentalia@dentalia.si

# --------------------------------------------------------------------------- #
# Compose project identity and host ports
# --------------------------------------------------------------------------- #
# docker-compose.yml carries no `name:`, so the project name is the directory
# the checkout lives in — `dentalia` for the main tree, `agent-xxxxxxxx` for a
# worktree under .claude/worktrees/. That is what lets two worktrees run their
# own stacks at once. Set this only if you want an explicit name.
# COMPOSE_PROJECT_NAME=dentalia-wt-eudamed

# REQUIRED. The host directory Postgres keeps its data in; compose refuses to
# start without it. The project name above does NOT move this bind, so a worktree
# that inherits the main checkout's value runs a second server on the registry's
# files. That happened from 08-27 to 09-09 and left the registry unstartable
# (docs/state/2026-09-11.md). Main checkout: the registry. A worktree: a fresh
# directory of its own (Postgres initialises an empty one on first start). WSL2:
# an ext4 path, never /mnt/... (9p breaks Postgres). Left commented here on
# purpose, so a copy of this file cannot point at the registry by accident.
# PGDATA_HOST=/srv/pgdata/dentalia                   # main checkout only
# PGDATA_HOST=/srv/pgdata/<worktree-name>            # a worktree

# The base compose file publishes NO host ports for Postgres: the suite runs
# inside the stack (scripts/test.sh execs into the `test` container and reaches
# `postgres:5432` on the compose network), and a published port is a host-global
# claim that stops a second worktree from starting.
#
# Uncomment for host-side access — psql, a GUI client, an ad-hoc script. Only
# one checkout can hold 5432; give a second one a different POSTGRES_PORT.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# POSTGRES_PORT=5432

# On a client server, instead of the dev overlay above: the prod overlay binds
# the archive to a host directory, caps the worker at 3g and rotates every
# container's log (docker-compose.prod.yml, docs/dev/deployment.md § 4).
# ARCHIVE_HOST is required once the overlay is on; compose refuses to start
# without it.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# ARCHIVE_HOST=/srv/compliance/archive
