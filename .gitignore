__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
pgdata/
/imports/
/archive-local/
# regenerable `python -m tools` output (datasets + reports); a report worth
# keeping gets copied into docs/ by hand
/analysis-out/
/backups/

# machine-local Claude settings (.claude/commands are shared, tracked)
.claude/settings.local.json
# scaffold artifact, already unpacked into the repo
dentalia-scaffold.zip

# Per-feature working scratch (ledgers, briefs, review packages)
.superpowers/

# per-tool agent config (Copilot). Untracked on purpose: it is one editor's
# instructions, not a project contract -- CLAUDE.md + docs/ are the contract.
# Ignored rather than committed so it stops showing as `??` in every session.
# Drop these two lines if the repo ever adopts .github/workflows.
/.github/copilot-instructions.md
/.github/instructions/
.env.bak-*

# Generated by scripts/build-guide.py. The per-page tree copies the woff2 fonts
# out of web/static, so committing it would duplicate them in the repo; it is
# cheap to regenerate. The single-file bundles ARE committed — they are what
# gets handed to the client, and they are the only offline-in-one-file copy.
/docs/guide/html/

# Signed commercial documents (offer, contract). Kept in the repo so scope
# questions are answered against the contract, never from memory. Never committed.
/docs/private/

# Playwright MCP scratch (page snapshots, console logs) written by whichever
# session last drove a browser. Regenerable and per-run; never source.
/.playwright-mcp/
# Ad-hoc screenshots dropped at the repo root while checking a page by hand.
# A screenshot worth keeping goes in docs/ with something written around it.
/full.png
.playwright-mcp/
/*.png

# Private working notes: billing/rate status. Never committed.
/notes/

# Per-branch agent worktrees: multi-GB scratch, and stray .env files with live
# API keys. Was excluded only via .git/info/exclude, which does not survive a
# copy of the tree. Never committed.
.claude/worktrees/

